{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "placemyorder.online"
        }
      ],
      "destination": "/site/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.placemyorder.online"
        }
      ],
      "destination": "/site/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "merchant.placemyorder.online"
        }
      ],
      "destination": "/m/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.placemyorder.online"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "sandbox.placemyorder.online"
        }
      ],
      "destination": "/site/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "sandbox-merchant.placemyorder.online"
        }
      ],
      "destination": "/m/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "sandbox-admin.placemyorder.online"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/",
      "destination": "/app-shell/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/support-inbound.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/housekeeping",
      "schedule": "0 4 * * *"
    }
  ]
}